<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ControllerVistaInici">
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Servidor">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <TextField fx:id="txtServidor" promptText="Pon la direccion IP del servidor aqui... (Ejemplo : 127.0.0.1)">
               <font>
                  <Font size="18.0" />
               </font>
            </TextField>
            <Label text="Jugador">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <TextField fx:id="txtJugador" promptText="Pon tu nombre de jugador aqui...">
               <font>
                  <Font size="18.0" />
               </font>
            </TextField>
            <Label fx:id="lblError" text="ERRORES" />
            <Button fx:id="btnConectar" mnemonicParsing="false" onAction="#handleConectar" text="Conectar">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="20.0" left="150.0" right="150.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="800.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" text="SUDOKU " textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="36.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
</BorderPane>
